import { Theme } from "components/Theme.slint";
import { UtilityCard } from "components/UtilityCard.slint";
import { PageHeader } from "components/PageHeader.slint";
import { InfoBanner } from "components/InfoBanner.slint";
import { CheckBox, ComboBox } from "std-widgets.slint";
import { SettingsSnapshot } from "Models.slint";

component SettingToggle inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> checked;
    callback toggled();

    property <bool> has_focus: focus_scope.has-focus;

    background: touch.has-hover ? Theme.bg_hover : (root.has_focus ? Theme.bg_hover : Theme.bg_surface);
    border-radius: Theme.radius_md;
    border-width: 1px;
    border-color: root.has_focus ? Theme.border_focus : Theme.border_subtle;

    animate background { duration: Theme.duration_fast; easing: ease-in-out; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }

    forward-focus: focus_scope;
    focus_scope := FocusScope {
        key-pressed(e) => {
            if (e.text == " " || e.text == "\n") {
                root.toggled();
                return accept;
            }
            return reject;
        }
    }

    HorizontalLayout {
        padding: Theme.space_4;
        spacing: Theme.space_4;
        alignment: space-between;

        VerticalLayout {
            spacing: Theme.space_1;
            Text { text: root.title; color: Theme.text_primary; font-family: Theme.font_family; font-size: Theme.text_base; font-weight: Theme.font_weight_semibold; }
            Text { text: root.description; color: Theme.text_secondary; font-family: Theme.font_family; font-size: Theme.text_sm; wrap: word-wrap; }
        }

        CheckBox {
            text: root.checked ? "On" : "Off";
            checked: root.checked;
            toggled => { root.toggled(); }
        }
    }
}

export component SettingsPage inherits Rectangle {
    in property <SettingsSnapshot> settings;
    callback update_setting(string, string);

    background: Theme.bg_app;

    Flickable {
        VerticalLayout {
            padding: Theme.space_8;
            spacing: Theme.space_6;
            max-width: Theme.content_max_width;

            PageHeader {
                eyebrow: "STEP 3 OF 5";
                title: "Choose restoration options";
                description: "Safe defaults are selected. You can change them now and review everything before the restore begins.";
            }

            VerticalLayout {
                spacing: Theme.space_3;
                Text { text: "Metadata"; color: Theme.text_primary; font-family: Theme.font_family; font-size: Theme.text_lg; font-weight: Theme.font_weight_semibold; }

                SettingToggle {
                    title: "Restore location data";
                    description: "Write latitude and longitude from the Takeout metadata when they are available.";
                    checked: root.settings.gps_enabled;
                    toggled => { root.update_setting("gps_enabled", root.settings.gps_enabled ? "false" : "true"); }
                }
                SettingToggle {
                    title: "Correct timezone information";
                    description: "Use available location data to apply the appropriate local timezone to timestamps.";
                    checked: root.settings.timezone_enabled;
                    toggled => { root.update_setting("timezone_enabled", root.settings.timezone_enabled ? "false" : "true"); }
                }
                SettingToggle {
                    title: "Separate files without metadata";
                    description: "Place unmatched files in an Unmatched folder at the destination instead of mixing them with restored files.";
                    checked: root.settings.unmatched_enabled;
                    toggled => { root.update_setting("unmatched_enabled", root.settings.unmatched_enabled ? "false" : "true"); }
                }
            }

            UtilityCard {
                VerticalLayout {
                    padding: Theme.space_4;
                    spacing: Theme.space_3;
                    Text { text: "Output behavior"; color: Theme.text_primary; font-family: Theme.font_family; font-size: Theme.text_lg; font-weight: Theme.font_weight_semibold; }
                    Text { text: "Copy mode is recommended because it keeps your Takeout files unchanged."; color: Theme.text_secondary; font-family: Theme.font_family; font-size: Theme.text_sm; }
                    HorizontalLayout {
                        spacing: Theme.space_3;
                        Text { text: "Mode"; color: Theme.text_primary; font-family: Theme.font_family; font-size: Theme.text_sm; vertical-alignment: center; }
                        ComboBox {
                            width: 280px;
                            model: ["Copy files to destination (recommended)", "Modify extracted files in place"];
                            current-index: root.settings.output_mode == "in-place" ? 1 : 0;
                            selected(value) => { root.update_setting("output_mode", value == "Modify extracted files in place" ? "in-place" : "copy"); }
                        }
                    }
                    if (root.settings.output_mode == "in-place"): InfoBanner {
                        title: "In-place mode changes extracted files";
                        message: "Use it only when the extracted source files are already backed up.";
                        status: "warning";
                    }
                }
            }

            VerticalLayout {
                spacing: Theme.space_3;
                Text { text: "Performance and privacy"; color: Theme.text_primary; font-family: Theme.font_family; font-size: Theme.text_lg; font-weight: Theme.font_weight_semibold; }
                SettingToggle {
                    title: "High performance mode";
                    description: "Use more CPU and disk activity to process faster. Your computer may be less responsive during the restore.";
                    checked: root.settings.high_performance;
                    toggled => { root.update_setting("high_performance", root.settings.high_performance ? "false" : "true"); }
                }
                SettingToggle {
                    title: "Anonymous diagnostic logging";
                    description: "Allow anonymous logs to help diagnose application issues.";
                    checked: root.settings.anonymous_logging;
                    toggled => { root.update_setting("anonymous_logging", root.settings.anonymous_logging ? "false" : "true"); }
                }
            }
        }
    }
}
