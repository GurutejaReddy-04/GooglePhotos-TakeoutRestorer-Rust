import { Theme } from "Theme.slint";
import { Card } from "Card.slint";

export component ChecklistCard inherits Card {
    in property <int> inputs_count: 0;
    in property <bool> destination_set: false;
    
    VerticalLayout {
        padding: Theme.space_4;
        spacing: Theme.space_4;
        
        Text {
            text: "Pre-flight Checklist";
            font-size: Theme.text_sm;
            font-weight: Theme.font_weight_bold;
            color: Theme.text_primary;
        }
        
        VerticalLayout {
            spacing: Theme.space_3;
            
            HorizontalLayout {
                spacing: Theme.space_3;
                Text { text: root.inputs_count > 0 ? "✓" : "○"; color: root.inputs_count > 0 ? Theme.status_success : Theme.text_secondary; font-weight: Theme.font_weight_bold; }
                Text { text: "Add Google Takeout sources"; color: root.inputs_count > 0 ? Theme.text_primary : Theme.text_secondary; font-size: Theme.text_sm; }
            }
            HorizontalLayout {
                spacing: Theme.space_3;
                Text { text: root.destination_set ? "✓" : "○"; color: root.destination_set ? Theme.status_success : Theme.text_secondary; font-weight: Theme.font_weight_bold; }
                Text { text: "Configure output settings"; color: root.destination_set ? Theme.text_primary : Theme.text_secondary; font-size: Theme.text_sm; }
            }
            HorizontalLayout {
                spacing: Theme.space_3;
                Text { text: (root.inputs_count > 0 && root.destination_set) ? "✓" : "○"; color: (root.inputs_count > 0 && root.destination_set) ? Theme.status_success : Theme.text_secondary; font-weight: Theme.font_weight_bold; }
                Text { text: "Ready to start"; color: (root.inputs_count > 0 && root.destination_set) ? Theme.text_primary : Theme.text_secondary; font-size: Theme.text_sm; }
            }
        }
    }
}
