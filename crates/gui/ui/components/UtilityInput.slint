import { Theme } from "Theme.slint";
import { UtilityButton } from "UtilityButton.slint";

export component UtilityInput {
    in-out property <string> text;
    in property <string> placeholder: "";
    in property <bool> enabled: true;
    in property <bool> has_action: false;
    in property <string> action_text: "Browse";
    
    callback accepted(string);
    callback action_clicked();

    min-height: 28px;
    height: 28px;
    width: 100%;

    HorizontalLayout {
        spacing: Theme.space_2;

        Rectangle {
            border-radius: Theme.radius_sm;
            border-width: 1px;
            border-color: input.has-focus ? Theme.border_focus : Theme.border_subtle;
            background: Theme.bg_surface;
            
            animate border-color { duration: Theme.duration_fast; }

            HorizontalLayout {
                padding-left: Theme.space_2;
                padding-right: Theme.space_2;
                
                input := TextInput {
                    text: root.text;
                    font-size: Theme.text_sm;
                    color: root.enabled ? Theme.text_primary : Theme.text_disabled;
                    vertical-alignment: center;
                    single-line: true;
                    
                    accepted => {
                        root.accepted(self.text);
                    }
                    edited => {
                        root.text = self.text;
                    }
                }
            }

            if input.text == "" && root.placeholder != "": Text {
                x: Theme.space_2;
                y: (parent.height - self.height) / 2;
                text: root.placeholder;
                font-size: Theme.text_sm;
                color: Theme.text_secondary;
            }
        }

        if root.has_action: UtilityButton {
            text: root.action_text;
            variant: "secondary";
            enabled: root.enabled;
            clicked => { root.action_clicked(); }
        }
    }
}
