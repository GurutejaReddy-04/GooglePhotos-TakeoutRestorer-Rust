import { ComboBox } from "std-widgets.slint";
import { Theme } from "Theme.slint";

export component SettingDropdown inherits Rectangle {
    in property <string> title: "Output Mode";
    in property <string> description: "Behavior for processed media files";
    in property <[string]> options: ["Copy files to destination", "Modify files in place"];
    in property <int> current_index: 0;
    in property <bool> enabled: true;

    callback selected(string);

    background: Theme.bg_surface;
    border-radius: Theme.radius_md;
    border-width: 1px;
    border-color: Theme.border_subtle;

    VerticalLayout {
        padding: Theme.space_3;
        spacing: Theme.space_2;

        VerticalLayout {
            spacing: 2px;
            Text {
                text: root.title;
                color: root.enabled ? Theme.text_primary : Theme.text_disabled;
                font-family: Theme.font_family;
                font-size: Theme.text_xs;
                font-weight: Theme.font_weight_semibold;
            }

            if (root.description != ""): Text {
                text: root.description;
                color: Theme.text_secondary;
                font-family: Theme.font_family;
                font-size: 11px;
                wrap: word-wrap;
            }
        }

        ComboBox {
            width: 100%;
            height: Theme.control_height;
            enabled: root.enabled;
            model: root.options;
            current-index: root.current_index;
            selected(val) => { root.selected(val); }
        }
    }
}
