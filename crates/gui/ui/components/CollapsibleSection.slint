import { Theme } from "Theme.slint";
import { Card } from "Card.slint";
import { SectionHeader } from "SectionHeader.slint";

export component CollapsibleSection inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <string> summary_chip: "";
    in-out property <bool> is_collapsed: true;

    VerticalLayout {
        spacing: Theme.space_2;

        forward-focus: focus_scope;
        focus_scope := FocusScope {
            key-pressed(e) => {
                if (e.text == " " || e.text == "\n") {
                    root.is_collapsed = !root.is_collapsed;
                    return accept;
                }
                return reject;
            }
        }

        TouchArea {
            height: 48px;
            mouse-cursor: pointer;
            clicked => { root.is_collapsed = !root.is_collapsed; }

            Rectangle {
                background: parent.has-hover ? Theme.bg_hover : Theme.bg_surface;
                border-radius: Theme.radius_md;
                animate background { duration: Theme.duration_fast; }
                border-width: focus_scope.has-focus ? 2px : 1px;
                border-color: focus_scope.has-focus ? Theme.border_focus : Theme.border_subtle;

                HorizontalLayout {
                    padding-left: Theme.space_4;
                    padding-right: Theme.space_4;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: Theme.space_3;
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.title;
                                font-size: Theme.text_sm;
                                font-weight: Theme.font_weight_bold;
                                color: Theme.text_primary;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.space_3;

                        if (root.summary_chip != ""): VerticalLayout {
                            alignment: center;
                            Rectangle {
                                background: Theme.bg_subtle;
                                border-radius: Theme.radius_sm;
                                height: 20px;

                                HorizontalLayout {
                                    padding-left: Theme.space_2;
                                    padding-right: Theme.space_2;
                                    Text {
                                        text: root.summary_chip;
                                        font-size: Theme.text_xs;
                                        color: Theme.text_secondary;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: root.is_collapsed ? "▼" : "▲";
                                color: Theme.text_secondary;
                                font-size: Theme.text_xs;
                            }
                        }
                    }
                }
            }
        }

        Card {
            visible: !root.is_collapsed;
            @children
        }
    }
}
