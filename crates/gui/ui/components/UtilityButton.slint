import { Theme } from "Theme.slint";

export component UtilityButton {
    in property <string> text;
    in property <string> icon;
    // primary, secondary, ghost, danger
    in property <string> variant: "secondary"; 
    in property <bool> enabled: true;
    
    callback clicked();

    property <bool> has_focus: focus_scope.has-focus;

    min-height: Theme.control_height;
    min-width: 60px;
    
    in property <bool> flex_width: false;
    horizontal-stretch: root.flex_width ? 1 : 0;

    states [
        disabled when !root.enabled: {
            touch.mouse-cursor: not-allowed;
            bg.background: root.variant == "primary" ? Theme.accent_primary_disabled : Theme.bg_surface;
            txt.color: Theme.text_disabled;
            icon-txt.color: Theme.text_disabled;
            bg.border-color: root.variant == "secondary" ? Theme.border_subtle : transparent;
        }
        primary when root.variant == "primary": {
            bg.background: touch.pressed ? Theme.accent_primary_disabled : (touch.has-hover ? Theme.accent_primary_hover : Theme.accent_primary);
            txt.color: Theme.text_on_accent;
            icon-txt.color: Theme.text_on_accent;
            bg.border-color: transparent;
        }
        danger when root.variant == "danger": {
            bg.background: touch.pressed ? Theme.status_error : (touch.has-hover ? Theme.status_error : Theme.status_error);
            // We adjust opacity/color on hover in a real app, for simplicity we just use error
            bg.background: touch.has-hover ? Theme.status_error.brighter(0.2) : Theme.status_error;
            txt.color: Theme.text_on_danger;
            icon-txt.color: Theme.text_on_danger;
            bg.border-color: transparent;
        }
        ghost when root.variant == "ghost": {
            bg.background: touch.pressed ? Theme.bg_hover : (touch.has-hover ? Theme.bg_hover : transparent);
            txt.color: touch.has-hover ? Theme.text_primary : Theme.text_secondary;
            icon-txt.color: touch.has-hover ? Theme.text_primary : Theme.text_secondary;
            bg.border-color: transparent;
        }
        // secondary is default
        secondary when root.variant == "secondary": {
            bg.background: touch.pressed ? Theme.bg_hover : (touch.has-hover ? Theme.bg_hover : Theme.bg_surface);
            txt.color: Theme.text_primary;
            icon-txt.color: Theme.text_primary;
            bg.border-color: Theme.border_subtle;
        }
    ]

    bg := Rectangle {
        border-radius: Theme.radius_md;
        border-width: root.has_focus ? 2px : 1px;
        border-color: root.has_focus ? Theme.border_focus : (root.variant == "secondary" ? Theme.border_subtle : transparent);
        
        animate background { duration: Theme.duration_fast; easing: ease-in-out; }
        animate border-color { duration: Theme.duration_fast; easing: ease-in-out; }
        
        HorizontalLayout {
            padding-left: Theme.space_3;
            padding-right: Theme.space_3;
            spacing: Theme.space_1;
            alignment: center;
            
            icon-txt := Text {
                visible: root.icon != "";
                text: root.icon;
                font-size: Theme.text_sm; // Ensure icon fits
                vertical-alignment: center;
                color: Theme.text_primary; // Overridden by states
            }
            
            txt := Text {
                visible: root.text != "";
                text: root.text;
                font-size: Theme.text_base;
                font-weight: Theme.font_weight_semibold;
                font-family: Theme.font_family;
                vertical-alignment: center;
                color: Theme.text_primary; // Overridden by states
            }
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            if root.enabled {
                root.clicked();
            }
        }
        mouse-cursor: pointer;
    }
    
    // Accessibility focus handling
    forward-focus: focus_scope;
    focus_scope := FocusScope {
        key-pressed(e) => {
            if (e.text == " " || e.text == "\n") && root.enabled {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}
