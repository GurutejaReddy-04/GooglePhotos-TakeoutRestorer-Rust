import { Theme } from "Theme.slint";

export component DirectoryPicker inherits HorizontalLayout {
    in property <string> label;
    in property <string> path;
    callback browse_clicked;

    spacing: 12px;
    alignment: stretch;
    vertical-stretch: 0;
    
    Text {
        text: root.label;
        color: Theme.text_primary;
        font-size: 14px;
        vertical-alignment: center;
        width: 80px;
    }
    
    Rectangle {
        horizontal-stretch: 1;
        height: 32px;
        border-color: Theme.border_subtle;
        border-width: 1px;
        border-radius: 4px;
        background: Theme.bg_app;
        
        Text {
            text: root.path;
            color: root.path == "" ? Theme.text_secondary : Theme.text_primary;
            vertical-alignment: center;
            x: 8px;
            width: parent.width - 16px;
            overflow: elide;
        }
    }
    
    Rectangle {
        width: 80px;
        height: 32px;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border_subtle;
        background: ta.has-hover ? Theme.bg_hover : transparent;
        
        Text {
            text: "Browse...";
            color: Theme.text_primary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        
        ta := TouchArea {
            clicked => { root.browse_clicked(); }
        }
    }
}
