import { Palette } from "std-widgets.slint";

export global Theme {
    // Determine dark mode natively via OS palette, can be overridden if needed.
    in property <bool> is_dark_mode: Palette.color-scheme == ColorScheme.dark;

    // --- COLORS ---
    
    // Backgrounds (Deepest to highest)
    out property <color> bg_app: is_dark_mode ? #0A0A0A : #F4F4F5;
    out property <color> bg_panel: is_dark_mode ? #111111 : #FFFFFF;
    out property <color> bg_surface: is_dark_mode ? #1A1A1A : #FAFAFA;
    out property <color> bg_hover: is_dark_mode ? #262626 : #F4F4F5;
    out property <color> bg_subtle: is_dark_mode ? #27272A : #E4E4E7;

    // Text
    out property <color> text_primary: is_dark_mode ? #EDEDED : #18181B;
    out property <color> text_secondary: is_dark_mode ? #A1A1AA : #71717A;
    out property <color> text_disabled: is_dark_mode ? #52525B : #A1A1AA;
    out property <color> text_inverted: is_dark_mode ? #0A0A0A : #FFFFFF;

    // Borders
    out property <color> border_subtle: is_dark_mode ? #27272A : #E4E4E7;
    out property <color> border_focus: is_dark_mode ? #E4E4E7 : #18181B;

    // Semantics (Same in light/dark for consistency, slight lightness tweaks)
    out property <color> status_error: is_dark_mode ? #EF4444 : #DC2626;
    out property <color> status_success: is_dark_mode ? #10B981 : #059669;
    out property <color> status_warning: is_dark_mode ? #F59E0B : #D97706;
    out property <color> status_info: is_dark_mode ? #3B82F6 : #2563EB;

    // Primary Accents (Monochrome high-contrast)
    out property <color> accent_primary: is_dark_mode ? #EDEDED : #18181B;
    out property <color> accent_primary_hover: is_dark_mode ? #D4D4D8 : #27272A;
    out property <color> accent_primary_disabled: is_dark_mode ? #3F3F46 : #E4E4E7;

    // --- TYPOGRAPHY ---
    // Note: Sizes in px scale logically in Slint.
    out property <string> font_family: "system-ui, -apple-system, sans-serif";
    
    out property <length> text_xs: 11px;
    out property <length> text_sm: 12px;
    out property <length> text_base: 14px;
    out property <length> text_lg: 16px;
    out property <length> text_xl: 20px;
    out property <length> text_2xl: 24px;

    out property <int> font_weight_medium: 500;
    out property <int> font_weight_semibold: 600;
    out property <int> font_weight_bold: 700;

    // --- SPACING ---
    out property <length> space_1: 4px;
    out property <length> space_2: 8px;
    out property <length> space_3: 12px;
    out property <length> space_4: 16px;
    out property <length> space_6: 24px;
    out property <length> space_8: 32px;

    // --- RADII ---
    out property <length> radius_sm: 4px;
    out property <length> radius_md: 6px;
    out property <length> radius_full: 9999px;

    // --- LAYOUT ---
    out property <length> list_item_height: 48px;

    // --- MOTION ---
    out property <duration> duration_fast: 100ms;
    out property <duration> duration_normal: 200ms;
}
