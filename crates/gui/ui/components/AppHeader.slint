import { Theme } from "Theme.slint";

export component AppHeader inherits Rectangle {
    in property <int> active_tab: 0;
    callback tab_clicked(int);
    callback toggle_theme();
    
    height: 60px;
    background: Theme.bg_surface;
    border-color: Theme.border_subtle;
    // Slint doesn't have border-bottom easily, so we just wrap in a layout with a bottom rect, or use a tiny rect
    
    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        alignment: space-between;
        
        Text {
            text: "Google Photos Takeout Restorer";
            font-size: 18px;
            font-weight: 700;
            color: Theme.text_primary;
            vertical-alignment: center;
        }
        
        HorizontalLayout {
            spacing: 8px;
            alignment: center;
            
            // Tab buttons
            for tab[i] in ["Welcome", "Dashboard", "Settings"]: Rectangle {
                width: 100px;
                height: 40px;
                y: 10px;
                border-radius: 4px;
                background: (root.active_tab == i) ? Theme.border_subtle.with-alpha(0.3) : (ta_tab.has-hover ? Theme.border_subtle.with-alpha(0.1) : transparent);
                
                Text {
                    text: tab;
                    color: (root.active_tab == i) ? Theme.accent_primary : Theme.text_primary;
                    font-weight: (root.active_tab == i) ? 600 : 400;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                
                ta_tab := TouchArea {
                    clicked => { root.tab_clicked(i); }
                }
            }
        }
        
        Rectangle {
            width: 120px;
            height: 40px;
            y: 10px;
            
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Text {
                    text: "Dark Mode";
                    color: Theme.text_primary;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 40px;
                    height: 20px;
                    y: 10px;
                    border-radius: 10px;
                    background: Theme.is_dark_mode ? Theme.accent_primary : Theme.border_subtle;
                    
                    Rectangle {
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        background: Theme.bg_surface;
                        x: Theme.is_dark_mode ? 22px : 2px;
                        y: 2px;
                        animate x { duration: 150ms; }
                    }
                    
                    ta_theme := TouchArea {
                        clicked => { root.toggle_theme(); }
                    }
                }
            }
        }
    }
    
    // Bottom border
    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.border_subtle;
    }
}
