import { Theme } from "Theme.slint";
import { ThemeSwitcher } from "ThemeSwitcher.slint";
import { StatusPill } from "StatusPill.slint";

export component AppHeader inherits Rectangle {
    in property <int> active_tab: 0;
    in property <string> os_platform: "windows";
    in property <string> theme: "System";
    in property <int> status_type: 0;
    in property <string> status_text: "Idle";
    
    callback tab_clicked(int);
    callback change_theme(string);
    callback settings_clicked();
    callback status_clicked();
    
    // Windows/Linux = 40px, macOS = 56px
    height: root.os_platform == "macos" ? 56px : 40px;
    background: Theme.bg_surface;
    
    // Bottom border
    Rectangle {
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.border_subtle;
    }
    
    HorizontalLayout {
        // macOS traffic light inset (left)
        padding-left: root.os_platform == "macos" ? 72px : 16px;
        padding-right: 16px;
        padding-top: root.os_platform == "macos" ? 16px : 0px;
        alignment: space-between;
        
        // Brand & Status
        HorizontalLayout {
            spacing: 16px;
            alignment: start;
            
            HorizontalLayout {
                spacing: 8px;
                Image {
                    source: @image-url("../../../../assets/icon.png");
                    width: 20px;
                    height: 20px;
                    image-fit: contain;
                    vertical-alignment: center;
                }
                Text {
                    text: "Google Photos Takeout Restorer";
                    font-size: Theme.text_sm;
                    font-family: Theme.font_family;
                    font-weight: Theme.font_weight_semibold;
                    color: Theme.text_primary;
                    vertical-alignment: center;
                }
            }
            
            StatusPill {
                status_type: root.status_type;
                text: root.status_text;
                y: (parent.height - self.height) / 2;
                clicked => { root.status_clicked(); }
            }
        }
        
        // Center: ViewTabs (Set Up | Run | Review)
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            
            for tab[i] in ["Set Up", "Run", "Review"]: Rectangle {
                width: 80px;
                height: 28px;
                border-radius: Theme.radius_md;
                background: root.active_tab == i ? Theme.bg_hover : (ta_tab.has-hover ? Theme.bg_subtle : transparent);
                
                Text {
                    text: tab;
                    color: root.active_tab == i ? Theme.text_primary : Theme.text_secondary;
                    font-size: Theme.text_sm;
                    font-weight: root.active_tab == i ? Theme.font_weight_semibold : Theme.font_weight_medium;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                
                ta_tab := TouchArea {
                    clicked => { root.tab_clicked(i); }
                }
            }
        }
        
        // Right: ThemeToggle & Settings
        HorizontalLayout {
            alignment: end;
            spacing: 12px;
            
            ThemeSwitcher {
                theme: root.theme;
                y: (parent.height - self.height) / 2;
                change_theme(t) => { root.change_theme(t); }
            }
            
            Rectangle {
                vertical-stretch: 1;
                width: 28px;
                
                gear_bg := Rectangle {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.radius_md;
                    background: ta_settings.has-hover ? Theme.bg_hover : transparent;
                    
                    Image {
                        source: @image-url("../../assets/icons/settings.svg");
                        width: 16px;
                        height: 16px;
                        colorize: Theme.text_secondary;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                    
                    ta_settings := TouchArea {
                        clicked => { root.settings_clicked(); }
                        mouse-cursor: pointer;
                    }
                }
            }
        }
    }
}
