import { Theme } from "Theme.slint";
import { ProcessingSnapshot } from "../Models.slint";
import { UtilityStepper } from "UtilityStepper.slint";

export component StageTracker inherits Rectangle {
    in property <ProcessingSnapshot> processing;
    
    background: Theme.bg_surface;
    border-color: Theme.border_subtle;
    border-width: 1px;
    border-radius: Theme.radius_md;
    height: 60px;
    
    HorizontalLayout {
        padding: 16px;
        alignment: center;
        
        UtilityStepper {
            current_step: root.processing.is_finished ? 6 : (root.processing.current_phase_text == "Scanning" ? 1 : 
                         (root.processing.current_phase_text == "Matching" ? 2 : 
                         (root.processing.current_phase_text == "Processing" ? 3 : 4)));
            steps: ["Scan", "Match", "EXIF", "TZ", "Write"];
        }
    }
}
