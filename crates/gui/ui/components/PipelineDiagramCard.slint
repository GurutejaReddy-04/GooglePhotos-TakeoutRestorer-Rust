import { Theme } from "Theme.slint";
import { Card } from "Card.slint";

export component PipelineDiagramCard inherits Card {
    VerticalLayout {
        padding: Theme.space_4;
        spacing: Theme.space_4;
        
        Text {
            text: "Restoration Pipeline";
            font-size: Theme.text_sm;
            font-weight: Theme.font_weight_bold;
            color: Theme.text_primary;
        }
        
        HorizontalLayout {
            alignment: center;
            spacing: Theme.space_2;
            
            for step[idx] in ["Scan", "Match", "Metadata", "Write"]: HorizontalLayout {
                spacing: Theme.space_2;
                alignment: center;
                
                Rectangle {
                    width: 24px; height: 24px; border-radius: 12px;
                    background: Theme.bg_subtle;
                    Text { text: idx + 1; color: Theme.text_secondary; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; font-weight: Theme.font_weight_bold; }
                }
                Text {
                    text: step;
                    color: Theme.text_secondary;
                    font-size: Theme.text_xs;
                    font-weight: Theme.font_weight_medium;
                }
                if idx < 3: Rectangle {
                    width: 16px; height: 1px; background: Theme.border_subtle;
                }
            }
        }
    }
}
