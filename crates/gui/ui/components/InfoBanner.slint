import { Theme } from "Theme.slint";

export component InfoBanner inherits Rectangle {
    in property <string> title: "";
    in property <string> message;
    // info, success, warning, error
    in property <string> status: "info";

    property <color> status_color: root.status == "success" ? Theme.status_success :
                                  (root.status == "warning" ? Theme.status_warning :
                                  (root.status == "error" ? Theme.status_error : Theme.status_info));

    background: root.status_color.with-alpha(0.11);
    border-radius: Theme.radius_md;
    border-width: 1px;
    border-color: root.status_color.with-alpha(0.65);

    HorizontalLayout {
        padding: Theme.space_3;
        spacing: Theme.space_3;

        Rectangle {
            width: 4px;
            background: root.status_color;
            border-radius: Theme.radius_full;
        }

        VerticalLayout {
            spacing: Theme.space_1;
            alignment: center;

            if (root.title != ""): Text {
                text: root.title;
                color: Theme.text_primary;
                font-family: Theme.font_family;
                font-size: Theme.text_sm;
                font-weight: Theme.font_weight_semibold;
            }

            Text {
                text: root.message;
                color: Theme.text_secondary;
                font-family: Theme.font_family;
                font-size: Theme.text_sm;
                wrap: word-wrap;
            }
        }
    }
}
