import { Theme } from "Theme.slint";

export component UtilityStepper {
    in property <int> current_step: 0;
    in property <[string]> steps: ["Import", "Destination", "Settings", "Export", "Results"];
    
    height: 32px;
    
    HorizontalLayout {
        spacing: Theme.space_4;
        alignment: start;
        
        for step[idx] in root.steps: HorizontalLayout {
            spacing: Theme.space_2;
            alignment: center;
            
            Text {
                text: idx + 1;
                font-size: Theme.text_sm;
                font-weight: Theme.font_weight_bold;
                color: idx == root.current_step ? Theme.text_inverted : Theme.text_secondary;
                
                // Number circle
                Rectangle {
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: idx == root.current_step ? Theme.accent_primary : transparent;
                    border-width: 1px;
                    border-color: idx == root.current_step ? transparent : Theme.border_subtle;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
            
            Text {
                text: step;
                font-size: Theme.text_sm;
                font-weight: idx == root.current_step ? Theme.font_weight_bold : Theme.font_weight_medium;
                color: idx == root.current_step ? Theme.text_primary : Theme.text_secondary;
                vertical-alignment: center;
            }
            
            if idx < root.steps.length - 1: Text {
                text: ">";
                font-size: Theme.text_xs;
                color: Theme.border_subtle;
                vertical-alignment: center;
                padding-left: Theme.space_2;
                padding-right: Theme.space_2;
            }
        }
    }
}
