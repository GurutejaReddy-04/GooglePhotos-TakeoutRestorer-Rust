import { Theme } from "Theme.slint";

export component DangerButton inherits Rectangle {
    in property <string> text: "";
    in property <string> icon: "";
    in property <bool> enabled: true;

    callback clicked();

    height: Theme.control_height;
    background: !root.enabled ? Theme.bg_subtle :
                (touch.pressed ? Theme.status_error :
                (touch.has-hover ? Theme.status_error : Theme.status_error.with-alpha(0.12)));
    border-radius: Theme.radius_md;
    border-width: focus_scope.has-focus ? 2px : 1px;
    border-color: focus_scope.has-focus ? Theme.border_focus :
                 (root.enabled ? Theme.status_error.with-alpha(0.5) : Theme.border_subtle);

    animate background { duration: Theme.duration_fast; easing: ease-in-out; }
    animate border-color { duration: Theme.duration_fast; easing: ease-in-out; }

    forward-focus: focus_scope;
    focus_scope := FocusScope {
        key-pressed(e) => {
            if (root.enabled && (e.text == " " || e.text == "\n")) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: Theme.space_3;
        padding-right: Theme.space_3;
        spacing: Theme.space_2;
        alignment: center;

        if (root.icon != ""): Text {
            text: root.icon;
            color: touch.has-hover ? Theme.text_on_danger : Theme.status_error;
            font-size: Theme.text_sm;
            font-weight: Theme.font_weight_bold;
            font-family: Theme.font_family;
            vertical-alignment: center;
        }

        Text {
            text: root.text;
            color: touch.has-hover ? Theme.text_on_danger : Theme.status_error;
            font-size: Theme.text_sm;
            font-weight: Theme.font_weight_semibold;
            font-family: Theme.font_family;
            vertical-alignment: center;
        }
    }
}
