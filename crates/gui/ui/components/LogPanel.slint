import { Theme } from "Theme.slint";

export component LogPanel inherits Rectangle {
    in property <[string]> logs: [];
    callback copy_log_path();

    background: Theme.bg_subtle;
    border-radius: Theme.radius_md;
    border-width: 1px;
    border-color: Theme.border_subtle;
    clip: true;

    VerticalLayout {
        spacing: 0px;

        // Panel header
        Rectangle {
            height: 32px;
            background: Theme.bg_panel;

            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Theme.border_subtle;
            }

            HorizontalLayout {
                padding-left: Theme.space_3;
                padding-right: Theme.space_3;
                alignment: space-between;

                HorizontalLayout {
                    spacing: Theme.space_2;
                    alignment: center;
                    Text {
                        text: "SYSTEM LOG ACTIVITY";
                        color: Theme.text_secondary;
                        font-family: Theme.font_family;
                        font-size: 10px;
                        font-weight: Theme.font_weight_bold;
                        vertical-alignment: center;
                    }

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 16px;
                            background: Theme.accent_soft;
                            border-radius: Theme.radius_full;
                            HorizontalLayout {
                                padding-left: 6px; padding-right: 6px;
                                alignment: center;
                                Text {
                                    text: root.logs.length + " lines";
                                    color: Theme.accent_primary;
                                    font-size: 10px;
                                    font-weight: Theme.font_weight_bold;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                TouchArea {
                    width: 110px;
                    mouse-cursor: pointer;
                    clicked => { root.copy_log_path(); }

                    HorizontalLayout {
                        spacing: 4px;
                        alignment: end;
                        Text {
                            text: "📋";
                            font-size: 11px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "Copy log path";
                            color: Theme.accent_primary;
                            font-family: Theme.font_family;
                            font-size: Theme.text_xs;
                            font-weight: Theme.font_weight_medium;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Log content view
        Rectangle {
            vertical-stretch: 1;

            if (root.logs.length == 0): VerticalLayout {
                alignment: center;
                Text {
                    text: "No log activity recorded yet.";
                    color: Theme.text_disabled;
                    font-family: Theme.font_family;
                    font-size: Theme.text_xs;
                    horizontal-alignment: center;
                }
            }

            if (root.logs.length > 0): Flickable {
                viewport-height: root.logs.length * 20px + Theme.space_2 * 2;

                VerticalLayout {
                    padding: Theme.space_2;
                    spacing: 0px;

                    for log[idx] in root.logs: HorizontalLayout {
                        height: 20px;
                        spacing: Theme.space_2;

                        Text {
                            width: 32px;
                            text: (idx + 1) + "";
                            color: Theme.text_disabled;
                            font-family: "monospace";
                            font-size: 11px;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: log;
                            color: Theme.text_secondary;
                            font-family: "monospace";
                            font-size: 11px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }
}
