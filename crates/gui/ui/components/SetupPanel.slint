import { Theme } from "Theme.slint";
import { CollapsibleSection } from "CollapsibleSection.slint";
import { OutputModeSelector } from "OutputModeSelector.slint";
import { PrimaryButton } from "PrimaryButton.slint";
import { SecondaryButton } from "SecondaryButton.slint";
import { SettingsSnapshot } from "../Models.slint";
import { SettingRow } from "SettingRow.slint";

export component SetupPanel inherits Rectangle {
    in property <[string]> inputs: [];
    in property <SettingsSnapshot> settings;
    in property <bool> is_processing: false;
    
    callback select_zip_files();
    callback select_folders();
    callback remove_input(string);
    callback select_destination();
    callback update_setting(string, string);
    callback start_restoration();

    background: Theme.bg_panel;
    border-color: Theme.border_subtle;
    border-width: 1px; // right border

    VerticalLayout {
        // Scrollable content
        Flickable {
            vertical-stretch: 1;
            padding: 16px;
            viewport-height: content_layout.preferred-height;
            
            content_layout := VerticalLayout {
                spacing: 16px;
                alignment: start;
                
                // Sources
                CollapsibleSection {
                    title: "Sources";
                    summary_chip: root.inputs.length > 0 ? "\{root.inputs.length} added" : "";
                    is_collapsed: false;
                    
                    VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 8px;
                            SecondaryButton {
                                text: "Add ZIPs";
                                clicked => { root.select_zip_files(); }
                            }
                            SecondaryButton {
                                text: "Add Folders";
                                clicked => { root.select_folders(); }
                            }
                        }
                        
                        for path in root.inputs: Rectangle {
                            height: 32px;
                            background: Theme.bg_subtle;
                            border-radius: Theme.radius_sm;
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px;
                                alignment: space-between;
                                Text { text: path; vertical-alignment: center; color: Theme.text_primary; font-size: Theme.text_sm; overflow: elide; }
                                TouchArea {
                                    width: 24px;
                                    clicked => { root.remove_input(path); }
                                    Text { text: "X"; vertical-alignment: center; horizontal-alignment: center; color: Theme.status_error; }
                                }
                            }
                        }
                    }
                }
                
                // Output
                CollapsibleSection {
                    title: "Output";
                    is_collapsed: false;
                    
                    VerticalLayout {
                        spacing: 16px;
                        OutputModeSelector {
                            output_mode: root.settings.output_mode;
                            mode_changed(m) => { root.update_setting("output_mode", m); }
                        }
                        
                        if (root.settings.output_mode == "copy"): HorizontalLayout {
                            spacing: 8px;
                            Text { text: "Dest:"; vertical-alignment: center; color: Theme.text_primary; font-size: Theme.text_sm; }
                            SecondaryButton {
                                horizontal-stretch: 1;
                                text: root.settings.destination_path == "" ? "Choose folder..." : root.settings.destination_path;
                                clicked => { root.select_destination(); }
                            }
                        }
                    }
                }
                
                // Advanced Options
                CollapsibleSection {
                    title: "Advanced";
                    summary_chip: "4/4"; // Simplify for now
                    is_collapsed: true;
                    
                    VerticalLayout {
                        spacing: 8px;
                        SettingRow {
                            title: "GPS Location Data";
                            description: "Restore EXIF GPS coordinates";
                            has_icon: true;
                            icon: @image-url("../../assets/icons/map-pin.svg");
                            checked: root.settings.gps_enabled;
                            toggled(c) => { root.update_setting("gps_enabled", c ? "true" : "false"); }
                        }
                        SettingRow {
                            title: "Timezone Correction";
                            description: "Adjust capture times by timezone";
                            has_icon: true;
                            icon: @image-url("../../assets/icons/clock.svg");
                            checked: root.settings.timezone_enabled;
                            toggled(c) => { root.update_setting("timezone_enabled", c ? "true" : "false"); }
                        }
                    }
                }
            }
        }
        
        // Sticky Footer CTA
        Rectangle {
            height: 80px;
            background: Theme.bg_surface;
            
            // top border
            Rectangle {
                y: 0; width: parent.width; height: 1px; background: Theme.border_subtle;
            }
            
            HorizontalLayout {
                padding: 16px;
                alignment: center;
                PrimaryButton {
                    text: "Start Restoration";
                    horizontal-stretch: 1;
                    enabled: root.inputs.length > 0 && (root.settings.output_mode == "in-place" || root.settings.destination_path != "");
                    clicked => { root.start_restoration(); }
                }
            }
        }
    }
}
