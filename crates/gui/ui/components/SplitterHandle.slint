import { Theme } from "Theme.slint";

export component SplitterHandle inherits Rectangle {
    width: 6px;
    background: Theme.bg_app;

    in property <int> min_panel_width: 240;
    in property <int> max_panel_width: 460;
    in-out property <int> panel_width: 340;
    callback width_changed(int);

    Rectangle {
        width: 1px;
        height: 100%;
        background: ta.has-hover || ta.pressed ? Theme.accent_primary : Theme.border_subtle;
        x: (parent.width - self.width) / 2;
        animate background { duration: Theme.duration_fast; }
    }

    ta := TouchArea {
        width: 12px;
        x: (parent.width - self.width) / 2;
        mouse-cursor: ew-resize;

        property <length> drag_start_width;

        pointer-event(event) => {
            if (event.button == PointerEventButton.left) {
                if (event.kind == PointerEventKind.down) {
                    self.drag_start_width = root.panel_width * 1px;
                }
            }
        }

        moved => {
            if (self.pressed) {
                let dx = self.mouse-x - self.pressed-x;
                let new_width = self.drag_start_width + dx;
                let new_w_int = Math.max(root.min_panel_width, Math.min(root.max_panel_width, Math.round(new_width / 1px)));
                
                if (new_w_int != root.panel_width) {
                    root.panel_width = new_w_int;
                    root.width_changed(new_w_int);
                }
            }
        }
    }
}
