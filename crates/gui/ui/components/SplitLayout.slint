import { SplitterHandle } from "SplitterHandle.slint";
import { SetupPanel } from "SetupPanel.slint";
import { WorkspaceCanvas } from "WorkspaceCanvas.slint";
import { SettingsSnapshot, ProcessingSnapshot, PastRun } from "../Models.slint";

export component SplitLayout inherits Rectangle {
    in-out property <int> left_panel_width: 340;
    
    in property <[string]> inputs: [];
    in property <SettingsSnapshot> settings;
    in property <bool> is_processing: false;
    
    callback select_zip_files();
    callback select_folders();
    callback remove_input(string);
    callback select_destination();
    callback update_setting(string, string);
    callback start_restoration();
    in property <ProcessingSnapshot> processing;
    in property <int> active_tab: 0;
    in property <[PastRun]> past_runs: [];
    
    HorizontalLayout {
        SetupPanel {
            width: root.left_panel_width * 1px;
            
            inputs: root.inputs;
            settings: root.settings;
            is_processing: root.is_processing;
            
            select_zip_files => { root.select_zip_files(); }
            select_folders => { root.select_folders(); }
            remove_input(s) => { root.remove_input(s); }
            select_destination => { root.select_destination(); }
            update_setting(k,v) => { root.update_setting(k, v); }
            start_restoration => { root.start_restoration(); }
        }
        SplitterHandle {
            panel_width <=> root.left_panel_width;
            min_panel_width: 240;
            max_panel_width: 460;
        }
        WorkspaceCanvas {
            horizontal-stretch: 1;
            processing: root.processing;
            active_tab: root.active_tab;
            inputs: root.inputs;
            settings: root.settings;
            past_runs: root.past_runs;
        }
    }
}
