import { Theme } from "Theme.slint";
import { StatusBadge } from "StatusBadge.slint";

export component StatusPill inherits Rectangle {
    in property <int> status_type: 0; // 0: Info/Idle, 1: Success/Completed, 2: Warning, 3: Error
    in property <string> text;
    callback clicked();
    
    in-out property <bool> has-focus: fs.has-focus;
    forward-focus: fs;
    
    height: 24px;
    width: badge.width;
    
    border-radius: Theme.radius_full;
    border-width: root.has-focus ? 2px : 0px;
    border-color: root.has-focus ? Theme.border_focus : transparent;
    
    badge := StatusBadge {
        status_type: root.status_type;
        text: root.text;
    }
    
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    
    fs := FocusScope {
        key-pressed(e) => {
            if (e.text == " " || e.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}
