import { Theme } from "components/Theme.slint";
import { UtilityButton } from "components/UtilityButton.slint";
import { UtilityCard } from "components/UtilityCard.slint";
import { PageHeader } from "components/PageHeader.slint";
import { InfoBanner } from "components/InfoBanner.slint";
import { LineEdit, ComboBox, ListView } from "std-widgets.slint";
import { ProcessingSnapshot } from "Models.slint";

component ResultMetric inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing: Theme.space_1;
    Text { text: root.label; color: Theme.text_secondary; font-family: Theme.font_family; font-size: Theme.text_xs; font-weight: Theme.font_weight_bold; }
    Text { text: root.value; color: Theme.text_primary; font-family: Theme.font_family; font-size: Theme.text_xl; font-weight: Theme.font_weight_bold; }
}

export component ResultsPage inherits Rectangle {
    in property <ProcessingSnapshot> processing;

    callback export_again();
    callback open_output_folder();
    callback copy_log_path();
    callback update_filter(string, string);

    property <string> current_search: "";
    property <string> current_filter: "All Files";
    property <string> terminal_title: processing.terminal_state == "failed" ? "Restoration failed" :
                                       (processing.terminal_state == "cancelled" ? "Restoration cancelled" :
                                       (processing.terminal_state == "completed_with_issues" ? "Restoration completed with issues" : "Restoration complete"));
    property <string> terminal_status: processing.terminal_state == "failed" ? "error" :
                                        (processing.terminal_state == "cancelled" || processing.terminal_state == "completed_with_issues" ? "warning" : "success");

    background: Theme.bg_app;

    VerticalLayout {
        padding: Theme.space_8;
        spacing: Theme.space_5;
        max-width: Theme.content_max_width;

        PageHeader {
            eyebrow: "STEP 5 OF 5";
            title: root.terminal_title;
            description: "Review the overall outcome, inspect individual files, and keep the log path if you need support.";
        }

        InfoBanner {
            title: root.terminal_title;
            message: root.processing.terminal_state == "failed" ? "The restore ended before it could finish. Review the log and error rows below." :
                     (root.processing.terminal_state == "cancelled" ? "The restore was stopped before all files were processed." :
                     root.processing.completed_files + " files processed in " + root.processing.elapsed_text + ".");
            status: root.terminal_status;
        }

        UtilityCard {
            VerticalLayout {
                padding: Theme.space_5;
                spacing: Theme.space_4;
                HorizontalLayout {
                    alignment: space-between;
                    ResultMetric { label: "FILES PROCESSED"; value: root.processing.completed_files; }
                    ResultMetric { label: "RESTORED"; value: root.processing.ok_count; }
                    ResultMetric { label: "NEED ATTENTION"; value: root.processing.error_count + root.processing.unmatched_count; }
                    ResultMetric { label: "OUTPUT SIZE"; value: round(root.processing.output_bytes / 1048576) + " MB"; }
                }
                Rectangle { height: 1px; background: Theme.border_subtle; }
                HorizontalLayout {
                    alignment: start;
                    spacing: Theme.space_3;
                    UtilityButton { text: "Open output folder"; variant: "primary"; clicked => { root.open_output_folder(); } }
                    UtilityButton { text: "Copy log path"; variant: "secondary"; clicked => { root.copy_log_path(); } }
                    UtilityButton { text: "Start another restore"; variant: "ghost"; clicked => { root.export_again(); } }
                }
            }
        }

        HorizontalLayout {
            alignment: space-between;
            Text { text: "File results"; color: Theme.text_primary; font-family: Theme.font_family; font-size: Theme.text_lg; font-weight: Theme.font_weight_semibold; }
            Text { text: root.processing.results.length + " matching files"; color: Theme.text_secondary; font-family: Theme.font_family; font-size: Theme.text_sm; vertical-alignment: center; }
        }

        HorizontalLayout {
            spacing: Theme.space_3;
            LineEdit {
                width: 320px;
                placeholder-text: "Search file name";
                text: root.current_search;
                edited(text) => { root.current_search = text; root.update_filter(root.current_search, root.current_filter); }
            }
            ComboBox {
                width: 168px;
                model: ["All Files", "Success", "Matched", "Unmatched", "Error", "Skipped"];
                current-index: root.current_filter == "Success" ? 1 : (root.current_filter == "Matched" ? 2 : (root.current_filter == "Unmatched" ? 3 : (root.current_filter == "Error" ? 4 : (root.current_filter == "Skipped" ? 5 : 0))));
                selected(value) => { root.current_filter = value; root.update_filter(root.current_search, root.current_filter); }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            min-height: 220px;
            background: Theme.bg_surface;
            border-radius: Theme.radius_md;
            border-width: 1px;
            border-color: Theme.border_subtle;
            clip: true;

            VerticalLayout {
                spacing: 0px;
                Rectangle {
                    height: 34px;
                    background: Theme.bg_subtle;
                    HorizontalLayout {
                        padding-left: Theme.space_4;
                        padding-right: Theme.space_4;
                        spacing: Theme.space_3;
                        Text { text: "STATUS"; width: 112px; color: Theme.text_secondary; font-family: Theme.font_family; font-size: Theme.text_xs; font-weight: Theme.font_weight_bold; vertical-alignment: center; }
                        Text { text: "FILE"; width: 28%; color: Theme.text_secondary; font-family: Theme.font_family; font-size: Theme.text_xs; font-weight: Theme.font_weight_bold; vertical-alignment: center; }
                        Text { text: "DESTINATION / DETAILS"; horizontal-stretch: 1; color: Theme.text_secondary; font-family: Theme.font_family; font-size: Theme.text_xs; font-weight: Theme.font_weight_bold; vertical-alignment: center; }
                    }
                }

                if (root.processing.results.length == 0): VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    Text { text: "No file results match the current filters."; color: Theme.text_secondary; font-family: Theme.font_family; font-size: Theme.text_sm; horizontal-alignment: center; }
                }

                if (root.processing.results.length > 0): ListView {
                    vertical-stretch: 1;
                    for result in root.processing.results: Rectangle {
                        height: 58px;
                        background: row_touch.has-hover ? Theme.bg_hover : transparent;
                        HorizontalLayout {
                            padding-left: Theme.space_4;
                            padding-right: Theme.space_4;
                            spacing: Theme.space_3;
                            HorizontalLayout {
                                width: 112px;
                                spacing: Theme.space_2;
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: Theme.radius_full;
                                    background: result.status == "Error" ? Theme.status_error :
                                                (result.status == "Unmatched" ? Theme.status_warning :
                                                (result.status == "Success" || result.status == "Matched" ? Theme.status_success : Theme.text_disabled));
                                    y: 25px;
                                }
                                Text { text: result.status; color: result.status == "Error" ? Theme.status_error : Theme.text_primary; font-family: Theme.font_family; font-size: Theme.text_sm; font-weight: Theme.font_weight_medium; vertical-alignment: center; overflow: elide; }
                            }
                            VerticalLayout {
                                width: 28%;
                                alignment: center;
                                Text { text: result.filename; color: Theme.text_primary; font-family: Theme.font_family; font-size: Theme.text_sm; font-weight: Theme.font_weight_medium; overflow: elide; }
                                Text { text: result.media_type; color: Theme.text_secondary; font-family: Theme.font_family; font-size: Theme.text_xs; overflow: elide; }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                Text { text: result.destination; color: Theme.text_secondary; font-family: Theme.font_family; font-size: Theme.text_sm; overflow: elide; }
                                Text { text: result.status == "Error" ? result.error : "Processed"; color: result.status == "Error" ? Theme.status_error : Theme.text_secondary; font-family: Theme.font_family; font-size: Theme.text_xs; overflow: elide; }
                            }
                        }
                        Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Theme.border_subtle; }
                        row_touch := TouchArea { }
                    }
                }
            }
        }
    }
}
