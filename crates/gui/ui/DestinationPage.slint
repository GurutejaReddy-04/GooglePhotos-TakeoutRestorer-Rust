import { Theme } from "components/Theme.slint";
import { UtilityButton } from "components/UtilityButton.slint";
import { UtilityCard } from "components/UtilityCard.slint";
import { PageHeader } from "components/PageHeader.slint";
import { InfoBanner } from "components/InfoBanner.slint";
import { SettingsSnapshot } from "Models.slint";

export component DestinationPage inherits Rectangle {
    in property <SettingsSnapshot> settings;
    callback select_destination();

    property <string> validation_status: root.settings.destination_validation.kind == "error" ? "error" :
                                        (root.settings.destination_validation.kind == "warning" ? "warning" : "success");

    background: Theme.bg_app;

    VerticalLayout {
        padding: Theme.space_8;
        spacing: Theme.space_6;
        alignment: start;
        max-width: Theme.content_max_width;

        PageHeader {
            eyebrow: "STEP 2 OF 5";
            title: "Choose where restored files go";
            description: "We validate this location before you continue. Your original Takeout sources remain untouched.";
        }

        UtilityCard {
            VerticalLayout {
                padding: Theme.space_6;
                spacing: Theme.space_4;

                Text { text: "Destination folder"; color: Theme.text_primary; font-family: Theme.font_family; font-size: Theme.text_base; font-weight: Theme.font_weight_semibold; }

                Rectangle {
                    height: 48px;
                    background: Theme.bg_subtle;
                    border-radius: Theme.radius_md;
                    border-width: 1px;
                    border-color: Theme.border_subtle;
                    HorizontalLayout {
                        padding-left: Theme.space_3;
                        padding-right: Theme.space_2;
                        spacing: Theme.space_3;
                        Text {
                            text: root.settings.destination_path == "" ? "No folder selected" : root.settings.destination_path;
                            color: root.settings.destination_path == "" ? Theme.text_secondary : Theme.text_primary;
                            font-family: Theme.font_family;
                            font-size: Theme.text_sm;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        UtilityButton {
                            text: root.settings.destination_path == "" ? "Choose folder" : "Change";
                            variant: root.settings.destination_path == "" ? "primary" : "secondary";
                            clicked => { root.select_destination(); }
                        }
                    }
                }

                if (root.settings.destination_path != ""): InfoBanner {
                    title: root.settings.destination_validation.kind == "valid" ? "Destination is ready" :
                           (root.settings.destination_validation.kind == "warning" ? "Destination needs attention" : "Destination cannot be used");
                    message: root.settings.destination_validation.message +
                             (root.settings.destination_validation.kind == "not_set" ? "" :
                             " • " + round(root.settings.destination_validation.free_gb * 10.0) / 10.0 + " GB free of " +
                             round(root.settings.destination_validation.total_gb) + " GB");
                    status: root.validation_status;
                }
            }
        }

        UtilityCard {
            VerticalLayout {
                padding: Theme.space_4;
                spacing: Theme.space_2;
                Text { text: "What happens next"; color: Theme.text_primary; font-family: Theme.font_family; font-size: Theme.text_base; font-weight: Theme.font_weight_semibold; }
                Text { text: "On the next screen you can confirm metadata, privacy, and performance choices. You will review everything once more before restoration starts."; color: Theme.text_secondary; font-family: Theme.font_family; font-size: Theme.text_sm; wrap: word-wrap; }
            }
        }
    }
}
