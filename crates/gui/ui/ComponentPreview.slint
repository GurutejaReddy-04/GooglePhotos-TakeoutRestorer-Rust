import { Theme } from "components/Theme.slint";
import { UtilityButton } from "components/UtilityButton.slint";
import { UtilityCard } from "components/UtilityCard.slint";
import { UtilityInput } from "components/UtilityInput.slint";
import { UtilityBadge } from "components/UtilityBadge.slint";
import { UtilityProgress } from "components/UtilityProgress.slint";
import { UtilityStepper } from "components/UtilityStepper.slint";
import { UtilityDialog } from "components/UtilityDialog.slint";

export component ComponentPreview inherits Window {
    title: "Design System Preview";
    width: 800px;
    height: 800px;
    background: Theme.bg_app;

    ScrollView {
        VerticalLayout {
            padding: Theme.space_6;
            spacing: Theme.space_8;

            Text {
                text: "Component Gallery";
                font-size: Theme.text_xl;
                font-weight: Theme.font_weight_bold;
                color: Theme.text_primary;
            }

            // Stepper Section
            VerticalLayout {
                spacing: Theme.space_4;
                Text { text: "Stepper Navigation"; font-size: Theme.text_lg; font-weight: Theme.font_weight_bold; color: Theme.text_primary; }
                UtilityStepper { current_step: 1; }
            }

            // Buttons Section
            VerticalLayout {
                spacing: Theme.space_4;
                Text { text: "Buttons"; font-size: Theme.text_lg; font-weight: Theme.font_weight_bold; color: Theme.text_primary; }
                
                HorizontalLayout {
                    spacing: Theme.space_4;
                    UtilityButton { text: "Primary"; variant: "primary"; }
                    UtilityButton { text: "Secondary"; variant: "secondary"; }
                    UtilityButton { text: "Ghost"; variant: "ghost"; }
                    UtilityButton { text: "Danger"; variant: "danger"; }
                }

                HorizontalLayout {
                    spacing: Theme.space_4;
                    UtilityButton { text: "Primary Disabled"; variant: "primary"; enabled: false; }
                    UtilityButton { text: "Secondary Disabled"; variant: "secondary"; enabled: false; }
                }
            }

            // Cards Section
            VerticalLayout {
                spacing: Theme.space_4;
                Text { text: "Cards"; font-size: Theme.text_lg; font-weight: Theme.font_weight_bold; color: Theme.text_primary; }
                
                HorizontalLayout {
                    spacing: Theme.space_4;
                    
                    UtilityCard {
                        width: 200px;
                        VerticalLayout {
                            padding: Theme.space_3;
                            Text { text: "Default Card"; color: Theme.text_primary; font-size: Theme.text_sm; }
                            Text { text: "Static container"; color: Theme.text_secondary; font-size: Theme.text_xs; }
                        }
                    }

                    UtilityCard {
                        width: 200px;
                        interactive: true;
                        VerticalLayout {
                            padding: Theme.space_3;
                            Text { text: "Interactive Card"; color: Theme.text_primary; font-size: Theme.text_sm; }
                            Text { text: "Hover me"; color: Theme.text_secondary; font-size: Theme.text_xs; }
                        }
                    }

                    UtilityCard {
                        width: 200px;
                        is_warning: true;
                        VerticalLayout {
                            padding: Theme.space_3;
                            Text { text: "Warning Card"; color: Theme.text_primary; font-size: Theme.text_sm; }
                            Text { text: "Something requires attention"; color: Theme.text_secondary; font-size: Theme.text_xs; }
                        }
                    }
                }
            }

            // Inputs Section
            VerticalLayout {
                spacing: Theme.space_4;
                Text { text: "Inputs"; font-size: Theme.text_lg; font-weight: Theme.font_weight_bold; color: Theme.text_primary; }
                
                VerticalLayout {
                    spacing: Theme.space_2;
                    width: 300px;
                    UtilityInput { placeholder: "Enter text..."; }
                    UtilityInput { placeholder: "Disabled input"; enabled: false; }
                    UtilityInput { text: "C:\\Takeout\\Photos.zip"; has_action: true; action_text: "Browse"; }
                }
            }

            // Badges Section
            VerticalLayout {
                spacing: Theme.space_4;
                Text { text: "Badges"; font-size: Theme.text_lg; font-weight: Theme.font_weight_bold; color: Theme.text_primary; }
                
                HorizontalLayout {
                    spacing: Theme.space_4;
                    UtilityBadge { text: "Info"; status: "info"; }
                    UtilityBadge { text: "Success"; status: "success"; }
                    UtilityBadge { text: "Warning"; status: "warning"; }
                    UtilityBadge { text: "Error"; status: "error"; }
                }
            }

            // Progress Section
            VerticalLayout {
                spacing: Theme.space_4;
                Text { text: "Progress"; font-size: Theme.text_lg; font-weight: Theme.font_weight_bold; color: Theme.text_primary; }
                
                VerticalLayout {
                    spacing: Theme.space_4;
                    width: 300px;
                    UtilityProgress { progress: 0.45; }
                    UtilityProgress { indeterminate: true; }
                }
            }
            
            // Dialog Simulation
            VerticalLayout {
                spacing: Theme.space_4;
                Text { text: "Dialogs"; font-size: Theme.text_lg; font-weight: Theme.font_weight_bold; color: Theme.text_primary; }
                
                HorizontalLayout {
                    spacing: Theme.space_4;
                    Rectangle {
                        width: 400px;
                        height: 200px;
                        clip: true;
                        UtilityDialog { 
                            title: "Confirm Export";
                            message: "Are you sure you want to export 5,000 files to the target directory?";
                        }
                    }
                    Rectangle {
                        width: 400px;
                        height: 200px;
                        clip: true;
                        UtilityDialog { 
                            title: "Fatal Database Error";
                            message: "The database could not persist the state. Do you want to recover the failed batch?";
                            is_warning: true;
                            accept_text: "Recover";
                        }
                    }
                }
            }
        }
    }
}
