import { Theme } from "components/Theme.slint";
import { UtilityButton } from "components/UtilityButton.slint";
import { UtilityCard } from "components/UtilityCard.slint";
import { UtilityBadge } from "components/UtilityBadge.slint";
import { UtilityProgress } from "components/UtilityProgress.slint";
import { PageHeader } from "components/PageHeader.slint";
import { ListView } from "std-widgets.slint";

export struct PastRun {
    id: string,
    title: string,
    last_active: string,
    percent_complete: int,
    completed_files: int,
    total_files: int,
    has_recovery_data: bool,
}

export component WelcomePage inherits Rectangle {
    callback create_new_project_clicked;
    callback resume_run_clicked(string);
    callback delete_run_clicked(string);
    callback recover_run_clicked(string);

    in property <[PastRun]> past_runs: [];

    background: Theme.bg_app;

    VerticalLayout {
        padding: Theme.space_10;
        spacing: Theme.space_8;
        alignment: start;
        max-width: Theme.content_max_width;

        PageHeader {
            eyebrow: "GOOGLE PHOTOS TAKEOUT";
            title: "Restore the metadata your photos deserve";
            description: "Choose Takeout archives or extracted folders, review where restored files go, then start with confidence.";
        }

        HorizontalLayout {
            spacing: Theme.space_4;
            alignment: start;

            UtilityButton {
                text: "New restore";
                icon: "+";
                variant: "primary";
                clicked => { root.create_new_project_clicked(); }
            }
            Text {
                text: "You can safely resume an interrupted restore below.";
                color: Theme.text_secondary;
                font-family: Theme.font_family;
                font-size: Theme.text_sm;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            spacing: Theme.space_4;

            UtilityCard {
                VerticalLayout {
                    padding: Theme.space_4;
                    spacing: Theme.space_2;
                    Text { text: "1"; color: Theme.accent_primary; font-family: Theme.font_family; font-size: Theme.text_lg; font-weight: Theme.font_weight_bold; }
                    Text { text: "Add sources"; color: Theme.text_primary; font-family: Theme.font_family; font-size: Theme.text_base; font-weight: Theme.font_weight_semibold; }
                    Text { text: "Select Takeout ZIP archives or extracted folders."; color: Theme.text_secondary; font-family: Theme.font_family; font-size: Theme.text_sm; wrap: word-wrap; }
                }
            }
            UtilityCard {
                VerticalLayout {
                    padding: Theme.space_4;
                    spacing: Theme.space_2;
                    Text { text: "2"; color: Theme.accent_primary; font-family: Theme.font_family; font-size: Theme.text_lg; font-weight: Theme.font_weight_bold; }
                    Text { text: "Choose a destination"; color: Theme.text_primary; font-family: Theme.font_family; font-size: Theme.text_base; font-weight: Theme.font_weight_semibold; }
                    Text { text: "Validate available space before any files are restored."; color: Theme.text_secondary; font-family: Theme.font_family; font-size: Theme.text_sm; wrap: word-wrap; }
                }
            }
            UtilityCard {
                VerticalLayout {
                    padding: Theme.space_4;
                    spacing: Theme.space_2;
                    Text { text: "3"; color: Theme.accent_primary; font-family: Theme.font_family; font-size: Theme.text_lg; font-weight: Theme.font_weight_bold; }
                    Text { text: "Review and restore"; color: Theme.text_primary; font-family: Theme.font_family; font-size: Theme.text_base; font-weight: Theme.font_weight_semibold; }
                    Text { text: "Track progress, inspect results, and resolve exceptions."; color: Theme.text_secondary; font-family: Theme.font_family; font-size: Theme.text_sm; wrap: word-wrap; }
                }
            }
        }

        if (root.past_runs.length == 0): UtilityCard {
            VerticalLayout {
                padding: Theme.space_6;
                spacing: Theme.space_2;
                Text { text: "No saved restores yet"; color: Theme.text_primary; font-family: Theme.font_family; font-size: Theme.text_lg; font-weight: Theme.font_weight_semibold; }
                Text { text: "Your recent and interrupted restores will appear here so they are easy to continue."; color: Theme.text_secondary; font-family: Theme.font_family; font-size: Theme.text_sm; }
            }
        }

        if (root.past_runs.length > 0): VerticalLayout {
            vertical-stretch: 1;
            spacing: Theme.space_3;

            Text {
                text: "Recent restores";
                color: Theme.text_primary;
                font-family: Theme.font_family;
                font-size: Theme.text_lg;
                font-weight: Theme.font_weight_semibold;
            }

            Rectangle {
                vertical-stretch: 1;
                clip: true;

                ListView {
                    for run in root.past_runs: VerticalLayout {
                        padding-bottom: Theme.space_3;
                        Rectangle {
                            height: 112px;
                            background: Theme.bg_surface;
                            border-radius: Theme.radius_md;
                            border-width: 1px;
                            border-color: run.has_recovery_data ? Theme.status_warning.with-alpha(0.65) : Theme.border_subtle;

                            VerticalLayout {
                                padding: Theme.space_4;
                                spacing: Theme.space_3;

                                HorizontalLayout {
                                    alignment: space-between;
                                    VerticalLayout {
                                        spacing: Theme.space_1;
                                        HorizontalLayout {
                                            spacing: Theme.space_2;
                                            Text { text: run.title; color: Theme.text_primary; font-family: Theme.font_family; font-size: Theme.text_base; font-weight: Theme.font_weight_semibold; }
                                            if (run.has_recovery_data): UtilityBadge { text: "Recovery available"; status: "warning"; }
                                            if (!run.has_recovery_data && run.percent_complete == 100): UtilityBadge { text: "Completed"; status: "success"; }
                                        }
                                        Text { text: "Last active " + run.last_active; color: Theme.text_secondary; font-family: Theme.font_family; font-size: Theme.text_xs; }
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.space_2;
                                        if (run.has_recovery_data): UtilityButton { text: "Recover"; variant: "secondary"; clicked => { root.recover_run_clicked(run.id); } }
                                        if (!run.has_recovery_data && run.percent_complete < 100): UtilityButton { text: "Resume"; variant: "secondary"; clicked => { root.resume_run_clicked(run.id); } }
                                        UtilityButton { text: "Delete"; variant: "ghost"; clicked => { root.delete_run_clicked(run.id); } }
                                    }
                                }

                                UtilityProgress { progress: run.percent_complete / 100.0; }
                                Text { text: run.completed_files + " of " + run.total_files + " files • " + run.percent_complete + "%"; color: Theme.text_secondary; font-family: Theme.font_family; font-size: Theme.text_xs; }
                            }
                        }
                    }
                }
            }
        }
    }
}
