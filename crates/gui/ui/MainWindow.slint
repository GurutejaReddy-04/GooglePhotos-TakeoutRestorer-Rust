import { Theme } from "components/Theme.slint";
export { Theme }
import { ThemeSwitcher } from "components/ThemeSwitcher.slint";
import { CollapsibleSection } from "components/CollapsibleSection.slint";
import { WelcomePage } from "WelcomePage.slint";
import { DestinationValidation, SettingsSnapshot, ProcessingSnapshot, PastRun } from "Models.slint";
import { WindowChrome } from "components/WindowChrome.slint";
import { SplitLayout } from "components/SplitLayout.slint";
import { AppHeader } from "components/AppHeader.slint";

export component MainWindow inherits WindowChrome {
    preferred-width: 1280px;
    preferred-height: 720px;
    min-width: 900px;
    min-height: 650px;

    in-out property <int> current_step: 0;
    in-out property <string> import_error: "";
    in-out property <int> active_tab: 0;
    in-out property <string> action_feedback: "";
    in-out property <bool> action_feedback_is_error: false;
    in property <string> os_platform: "windows";
    
    in property <bool> back_button_enabled: false;
    in property <string> next_button_text: "";
    in-out property <string> pending_delete_run_id: "";
    in-out property <string> pending_delete_run_title: "";
    in property <bool> show_fatal_error: false;
    in property <string> fatal_error_message: "";
    
    in property <[PastRun]> past_runs: [];
    in property <[string]> inputs: [];
    in property <SettingsSnapshot> settings;
    in property <ProcessingSnapshot> processing;
    
    // Callbacks
    callback go_next();
    callback go_back();
    callback shutdown_requested();
    callback resume_run_clicked(string);
    callback delete_run_clicked(string);
    callback delete_run_confirmed(string);
    callback clear_all_runs_confirmed();
    callback recover_run_clicked(string);
    callback select_zip_files();
    callback select_folders();
    callback select_destination();
    callback remove_input(string);
    callback clear_inputs();
    callback change_theme(string);
    callback update_setting(string, string);
    callback start_processing();
    callback stop_processing();
    callback export_again();
    callback open_output_folder();
    callback copy_log_path();
    callback update_results_filter(string, string);

    VerticalLayout {
        // App Header
        AppHeader {
            os_platform: root.os_platform;
            active_tab: root.active_tab;
            theme: root.settings.theme;
            status_type: root.show_fatal_error ? 3 : (root.processing.is_finished ? 1 : (root.processing.is_processing ? 1 : 0));
            status_text: root.show_fatal_error ? "Error" : (root.processing.is_finished ? "Completed" : (root.processing.is_processing ? "Running" : "Idle"));
            
            tab_clicked(i) => { root.active_tab = i; }
            change_theme(t) => { root.change_theme(t); }
            settings_clicked() => { /* handled later */ }
            status_clicked() => { root.active_tab = 1; }
        }

        // Split Layout Placeholder
        SplitLayout {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            left_panel_width: root.settings.sidebar_width;
            
            inputs: root.inputs;
            settings: root.settings;
            is_processing: root.processing.is_processing;
            processing: root.processing;
            active_tab: root.active_tab;
            past_runs: root.past_runs;
            
            select_zip_files => { root.select_zip_files(); }
            select_folders => { root.select_folders(); }
            remove_input(s) => { root.remove_input(s); }
            select_destination => { root.select_destination(); }
            update_setting(k,v) => { root.update_setting(k, v); }
            start_restoration => { root.start_processing(); }
        }
    }
}
